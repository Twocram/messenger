{
  "name": "messenger",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter @messenger/backend dev",
    "dev:frontend": "bun run --filter @messenger/frontend dev",
    "dev:shared": "bun run --filter @messenger/shared dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "db:push": "bun run --cwd packages/backend db:push",
    "db:studio": "bun run --cwd packages/backend db:studio",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.3.8",
    "oxlint": "^1.43.0",
    "typescript": "^5.7.0"
  }
}
